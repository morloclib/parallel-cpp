module bench-cross-parallel-cpp (seqMap, parMap)

-- The C++ pmap over a Python `spin`: every work unit crosses into the Python
-- pool, so chunk size sets how often.
import parallel.bench
import parallel-cpp
import root-py

source Py from "benchcosts.py"
  ( "spin"
  , "spin_keep" as spinKeep
  , "spin_list" as spinList
  , "make_str" as makeStr
  , "str_cost" as strCost
  )
